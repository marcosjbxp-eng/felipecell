# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env!

# Chave secreta do Django — gere uma nova em https://djecrety.ir/
DJANGO_SECRET=gere-uma-chave-nova-aqui

# Modo debug — True apenas em desenvolvimento local, False em produção
DEBUG=False

# Hosts permitidos — separados por vírgula (ex: 192.168.1.10,meusite.com)
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens CSRF confiáveis (ex: https://meusite.com)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Google OAuth (allauth)
GOOGLE_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_SECRET=seu-client-secret

# Cloudinary
CLOUDINARY_NAME=seu-cloud-name
CLOUDINARY_API=sua-api-key
CLOUDINARY_SECRET=seu-api-secret

# Token secreto para o webhook do bot (gere um aleatório longo)
# Exemplo: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET_TOKEN=gere-um-token-aleatorio-aqui
